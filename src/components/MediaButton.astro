---
import { ArrowRight } from "lucide-react";

interface Props {
  platform: "spotify" | "youtube";
  href?: string;
}

const { platform, href } = Astro.props;
const isSpotify = platform === "spotify";
const name = isSpotify ? "Spotify" : "YouTube";
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["media-button", platform]}
  href={href}
  target={href ? "_blank" : undefined}
  type={href ? undefined : "button"}
  disabled={!href}
  title={!href ? `${name}: próximamente` : undefined}
>
  <svg class="platform-icon" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
    {isSpotify ? (
      <>
        <circle cx="28" cy="28" r="27" fill="white" />
        <g fill="none" stroke="var(--platform-color)" stroke-linecap="round">
          <path d="M13 20c10-3 22-2 31 3" stroke-width="4.5" />
          <path d="M15 29c9-2 19-1 26 3" stroke-width="4" />
          <path d="M17 38c7-2 14-1 21 2" stroke-width="3.5" />
        </g>
      </>
    ) : (
      <>
        <path d="M52 14c-1-3-3-4-6-4-12-1-24-1-36 0-3 0-5 1-6 4-2 9-2 19 0 28 1 3 3 4 6 4 12 1 24 1 36 0 3 0 5-1 6-4 2-9 2-19 0-28Z" fill="white" />
        <path d="m23 20 14 8-14 8Z" fill="var(--platform-color)" />
      </>
    )}
  </svg>
  <span class="button-copy">
    <span>{isSpotify ? "Escúchanos en" : "Míranos en"}</span>
    <strong>{name}</strong>
  </span>
  <ArrowRight className="media-arrow" size={26} aria-hidden="true" />
</Tag>

<style>
  .media-button { display: flex; align-items: center; gap: 18px; width: 100%; min-width: 0; min-height: 102px; padding: 20px 24px; border: 0; border-radius: 999px; background: var(--platform-color); color: white; text-align: left; }
  .spotify { --platform-color: #16cf58; }
  .youtube { --platform-color: #ff0033; }
  .platform-icon { width: 54px; height: 54px; flex-shrink: 0; }
  .button-copy { display: grid; gap: 3px; font-size: 18px; line-height: 1.2; }
  .button-copy strong { font-size: 25px; font-weight: 700; }
  .media-button :global(.media-arrow) { flex-shrink: 0; margin-left: auto; }
  .media-button:focus-visible { outline: 3px solid var(--color-verde-dark); outline-offset: 4px; }
  button:disabled { cursor: default; }
  @media (max-width: 639px) {
    .media-button { min-height: 82px; padding: 16px 20px; gap: 14px; }
    .platform-icon { width: 42px; height: 42px; }
    .button-copy { font-size: 15px; }
    .button-copy strong { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .media-button { transition: none; } a.media-button:hover { transform: none; } }
</style>
