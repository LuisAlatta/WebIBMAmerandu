---
import ameranduLogo from "../assets/images/amerandu-logo.webp";
const year = new Date().getFullYear();
const legalLinks = [
  { label: "Términos y Condiciones", href: "/politicas-de-privacidad" },
  { label: "Política de Privacidad", href: "/politicas-de-privacidad" },
  { label: "Código de Ética", href: "/politicas-de-privacidad" },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-columns">
      <a href="/#inicio" class="footer-brand" aria-label="Amerandú — Inicio">
        <img
          src={ameranduLogo.src}
          width={ameranduLogo.width}
          height={ameranduLogo.height}
          alt="Amerandú — Club de lectura y pensamiento latinoamericano"
          loading="lazy"
        />
      </a>

      <div class="footer-contact">
        <h2>Contacto</h2>
        <a href="mailto:ameranduclub@gmail.com">ameranduclub@gmail.com</a>
      </div>

      <nav aria-labelledby="footer-legal-title">
        <h2 id="footer-legal-title">Legal</h2>
        <ul>
          {legalLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2>Seguínos</h2>
        <a
          href="https://linkedin.com/company/amerandu"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Amerandú (abre en una nueva pestaña)"
          class="footer-social"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Amerandú. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-footer-bg); color: white; padding-block: 135px 95px; }
  .footer-inner { width: min(100% - 64px, 1200px); margin-inline: auto; }
  .footer-columns { display: grid; grid-template-columns: .95fr 1.2fr 1.2fr 1fr; gap: 50px; align-items: start; }
  .footer-columns > * { min-width: 0; }
  .footer-brand { display: block; width: 210px; max-width: 100%; }
  .footer-brand img { display: block; width: 100%; height: auto; }
  h2 { color: #ff926f; font-size: 22px; line-height: 1.2; font-weight: 700; text-transform: uppercase; margin-bottom: 18px; }
  a { font-size: 18px; line-height: 1.5; text-decoration: none; transition: color .2s ease; }
  a:hover { color: #ff926f; }
  a:focus-visible { outline: 2px solid #ff926f; outline-offset: 5px; border-radius: 3px; }
  .footer-contact a { overflow-wrap: anywhere; }
  ul { display: grid; gap: 5px; }
  .footer-social { display: inline-flex; align-items: center; gap: 10px; }
  .footer-social svg { width: 19px; height: 19px; flex-shrink: 0; }
  .footer-bottom { margin-top: 52px; padding-top: 46px; border-top: 1px solid rgb(255 255 255 / .55); text-align: center; }
  .footer-bottom p { font-size: 16px; line-height: 1.5; letter-spacing: .035em; }
  @media (max-width: 1100px) { .footer-columns { gap: 30px; } a { font-size: 16px; } h2 { font-size: 20px; } }
  @media (max-width: 900px) { .site-footer { padding-block: 80px 65px; } .footer-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; } }
  @media (max-width: 539px) {
    .site-footer { padding-block: 55px 40px; }
    .footer-inner { width: calc(100% - 40px); }
    .footer-columns { grid-template-columns: 1fr; gap: 30px; }
    .footer-brand { width: 200px; margin-bottom: 5px; }
    h2 { margin-bottom: 12px; }
    .footer-bottom { margin-top: 36px; padding-top: 28px; }
    .footer-bottom p { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
