---
interface Props {
  episodeId: string;
  title?: string;
}

const { episodeId, title = "Escucha el podcast de Amerandú en Spotify" } = Astro.props;
const embedUrl = `https://open.spotify.com/embed/episode/${encodeURIComponent(episodeId)}`;
---

<iframe
  class="spotify-embed"
  src={embedUrl}
  title={title}
  width="100%"
  height="352"
  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
  allowfullscreen
  loading="lazy"
></iframe>

<style>
  .spotify-embed { display: block; width: 100%; height: 352px; border: 0; border-radius: 12px; }
</style>
