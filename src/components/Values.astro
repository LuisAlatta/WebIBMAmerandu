---
import { BadgeCheck, MessageCircleMore, UsersRound, Brain } from "lucide-react";
import WaveDivider from "./WaveDivider.astro";
import "../styles/landing-sections.css";
import plantas from "../assets/images/plantas-vertical.svg";
import plantas2 from "../assets/images/plantas-2.svg";
const values = [
  { title: "Identidad latinoamericana", icon: BadgeCheck, text: "Revalorizar nuestras tradiciones, literatura e ideas." },
  { title: "Diálogo", icon: MessageCircleMore, text: "Intercambiar perspectivas y construir conocimiento juntos." },
  { title: "Comunidad", icon: UsersRound, text: "Un espacio para compartir lecturas, ideas y experiencias." },
  { title: "Pensamiento crítico", icon: Brain, text: "Reflexionar sobre las ideas, textos y realidades de Latinoamérica." },
];
---
<section id="valores" class="landing-section values" aria-labelledby="values-title">
  <div class="plants-decoration" aria-hidden="true">
    <div class="plant-left" style={{ backgroundImage: `url("${plantas.src}")` }}></div>
    <div class="plant-bottom" style={{ backgroundImage: `url("${plantas2.src}")` }}></div>
  </div>
  <div class="section-inner">
    <div class="values-heading"><p class="section-kicker">Nuestros valores</p><h2 id="values-title" class="section-title">Lo que nos mueve</h2></div>
    <div class="values-grid">
      {values.map(({title, icon: Icon, text}) => <article class="value-card"><div class="value-icon"><Icon size={37} strokeWidth={2.4} aria-hidden="true" /></div><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </div>
  <div class="section-wave" aria-hidden="true"><WaveDivider fillColor="#FFFFFF" variant="wave2" /></div>
</section>
<style>
  .values { background: var(--section-cream); padding-block: 95px 140px; color: var(--section-terracotta); }
  .values-heading { max-width: 630px; margin-bottom: 55px; }
  .values-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 25px; }
  .value-card { min-height: 280px; padding: 38px 22px 32px; border-radius: 180px 180px 13px 13px; background: var(--section-coral); box-shadow: inset 0 3px 4px rgb(0 0 0 / .24); text-align: center; }
  .value-card:nth-child(even) { background: var(--section-mint); color: var(--color-verde-dark); }
  .value-icon { width: 66px; height: 66px; display: grid; place-items: center; border-radius: 50%; margin: 0 auto 26px; background: inherit; box-shadow: 0 4px 4px rgb(0 0 0 / .22); }
  h3 { font-size: 19px; font-weight: 700; text-transform: uppercase; line-height: 1.05; margin-bottom: 12px; }
  .value-card p { font-size: 16px; line-height: 1.16; letter-spacing: .035em; }
  .plants-decoration { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .plant-left, .plant-bottom { position: absolute; width: 160px; background-repeat: no-repeat; background-size: contain; }
  .plant-left { left: 0px; top: 18px; height: 80%; background-position: left top; }
  .plant-bottom { right: 0px; bottom: 0px; height: 100%; background-position: right bottom; }
  @media (max-width: 1050px) { .values-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; max-width: 700px; margin-inline: auto; } .value-card { padding-inline: 30px; } }
  @media (max-width: 639px) { .values { padding-block: 65px 90px; } .values-heading { margin-bottom: 35px; } .values-grid { grid-template-columns: 1fr; max-width: 320px; } .value-card { min-height: 285px; padding-top: 40px; } }
  @media (max-width: 639px) { .plant-left, .plant-bottom { width: 90px; opacity: .35; } }
</style>
