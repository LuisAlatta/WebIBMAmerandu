---
import { Clock3, House, Award, Check, Video } from "lucide-react";
import Button from "./Button.astro";
import plantas from "../assets/images/plantas-3.svg";
import plantas2 from "../assets/images/plantas-4.svg";
import "../styles/landing-sections.css";
interface Props { participantImage?: string; volunteerImage?: string; }
const { participantImage, volunteerImage } = Astro.props;
const sharedFeatures = [
  { icon: Clock3, text: "Duración: 6 meses" },
  { icon: House, text: "100% virtual" },
  { icon: Award, text: "Certificado de participación" },
];
const blocks = [
  { title: "Quiero participar", text: "Súmate a los encuentros mensuales de lectura y diálogo sobre literatura y pensamiento latinoamericano.", image: participantImage, alt: "Participantes en un encuentro virtual de Amerandú", features: [...sharedFeatures, {icon: Check, text: "No es necesario experiencia previa"}], button: "Unirme al club" },
  { title: "Quiero ser voluntario", text: "Colaborá en la organización, selección de lecturas y difusión del club.", image: volunteerImage, alt: "Equipo de voluntariado en un encuentro virtual de Amerandú", features: [...sharedFeatures, {icon: Check, text: "Participación no remunerada"}, {icon: Check, text: "No es necesario experiencia previa"}], button: "Ser voluntario" },
];
---
<section id="unete" class="landing-section join" aria-labelledby="join-title">
  <div class="plants-decoration" aria-hidden="true">
    <div class="plant-top" style={{ backgroundImage: `url("${plantas.src}")` }}></div>
    <div class="plant-bottom" style={{ backgroundImage: `url("${plantas2.src}")` }}></div>
  </div>
  <div class="dots" aria-hidden="true"></div>
  <div class="section-inner">
    <div class="join-heading"><p class="section-kicker centered">Encuentra tu lugar</p><h2 id="join-title" class="section-title">Únete a Amerandú</h2><p class="intro">Encuentros virtuales para compartir lecturas, ideas y conversaciones sobre Latinoamérica.</p></div>
    <div class="join-blocks">
      {blocks.map(({ title, text, image, alt, features, button }, index) => <article class:list={["join-block", { volunteer: index === 1 }]}>
        <div class="join-copy">
          <h3>{title}</h3><p class="description">{text}</p>
          <div class="features-and-note">
            <ul class="features">{features.map(({icon: Icon, text}) => <li><Icon size={23} strokeWidth={2.5} aria-hidden="true" /><span>{text}</span></li>)}</ul>
            {index === 1 && <aside class="roles"><span class="pin" aria-hidden="true"></span><h4>Roles disponibles:</h4><ul><li>Moderadores de encuentros.</li><li>Coordinación del club.</li><li>Manejo de redes y creación de contenido.</li></ul></aside>}
          </div>
          <Button compact href={index === 1 ? "#contact-tab-volunteer" : "#contact-tab-club"}>{button}</Button>
        </div>
        <div class="photo-frame">
          {image ? <img src={image} alt={alt} loading="lazy" /> : <div class="photo-placeholder" role="img" aria-label={alt}><Video size={44} strokeWidth={1} aria-hidden="true" /><span>Encuentros virtuales</span></div>}
        </div>
      </article>)}
    </div>
  </div>
</section>
<style>
  .join { background: var(--section-mint); padding-block: 90px 155px; }
  .join-heading { text-align: center; color: var(--color-verde-dark); max-width: 650px; margin-inline: auto; }
  .join-heading .section-kicker { max-width: 490px; }
  .intro { color: var(--color-texto); max-width: 500px; margin: 22px auto 0; font-size: 17px; line-height: 1.2; }
  .join-blocks { display: grid; gap: 95px; margin-top: 90px; }
  .join-block { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 65px; }
  .join-copy { min-width: 0; }
  h3 { font-size: clamp(1.6rem, 2.5vw, 2.25rem); font-weight: 700; line-height: 1.1; text-transform: uppercase; color: var(--color-verde-dark); margin-bottom: 14px; }
  .description { font-size: 17px; line-height: 1.2; max-width: 510px; }
  .features-and-note { display: flex; align-items: center; gap: 20px; margin-block: 30px; }
  .features { display: grid; gap: 20px; }
  .features li { display: flex; align-items: center; gap: 14px; font-size: 16px; line-height: 1.3; }
  .features :global(svg) { color: var(--color-verde-dark); flex-shrink: 0; }
  .photo-frame { width: 100%; aspect-ratio: 1.36; border: 4px solid white; border-radius: 18% 53% 24% 27% / 38% 18% 28% 39%; overflow: hidden; box-shadow: 0 4px 3px rgb(0 0 0 / .22); background: #b2dccc; }
  .photo-frame img { width: 100%; height: 100%; object-fit: cover; }
  .photo-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; color: var(--color-verde-dark); font-size: 14px; }
  .volunteer .photo-frame { grid-column: 1; grid-row: 1; border-radius: 43% 54% 26% 88% / 29% 24% 26% 30%; }
  .volunteer .join-copy { grid-column: 2; grid-row: 1; }
  .roles { flex: 0 0 160px; padding: 18px 17px; background: white; border-radius: 18px; transform: rotate(-5deg); box-shadow: 0 3px 3px rgb(0 0 0 / .2); font-size: 12px; line-height: 1.2; }
  .pin { display: block; width: 10px; height: 10px; border-radius: 50%; background: #141414; margin: 0 auto 14px; }
  .roles h4 { font-weight: 700; margin-bottom: 12px; }
  .roles ul { list-style: disc; padding-left: 13px; }
  .roles li + li { margin-top: 6px; }
  .dots { position: absolute; width: 470px; height: 370px; left: 28%; top: 43%; opacity: .16; background-image: radial-gradient(var(--color-verde-dark) 1.5px, transparent 1.7px); background-size: 21px 21px; pointer-events: none; }
  .plants-decoration { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .plant-top, .plant-bottom { position: absolute; width: 160px; background-repeat: no-repeat; background-size: contain; }
  .plant-top { left: 0px; top: 0px; height: 100%; width: 300px; background-position: left top; }
  .plant-bottom { right: 0; bottom: 0; height: 100%; width: 180px; background-position: right bottom; }
  @media (max-width: 1150px) { .join-block { gap: 35px; } .features-and-note { flex-wrap: wrap; } .roles { flex-basis: 185px; margin: 8px 0 0 auto; } }
  @media (max-width: 767px) { .join { padding-block: 65px 100px; } .join-blocks { margin-top: 55px; gap: 65px; } .join-block { grid-template-columns: 1fr; gap: 35px; } .volunteer .join-copy, .volunteer .photo-frame { grid-column: auto; grid-row: auto; } .photo-frame { max-width: 540px; margin-inline: auto; } .intro, .description { font-size: 16px; } .roles { margin-right: 10px; } .dots { left: 10%; width: 80%; } }
  @media (max-width: 639px) { .plant-top, .plant-bottom { width: 90px; opacity: .35; } }
</style>
