---
import Button from "./Button.astro";
import WaveDivider from "./WaveDivider.astro";
import "../styles/landing-sections.css";
interface Props { backgroundImage?: string; }
const { backgroundImage } = Astro.props;
---
<section id="inicio" class="landing-section hero" aria-labelledby="hero-title">
  <!-- Set backgroundImage to add the definitive photograph. -->
  {backgroundImage && <img class="hero-background" src={backgroundImage} alt="" fetchpriority="high" />}
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="section-inner hero-content">
    <h1 id="hero-title"><span>Lee, conversa</span><span>y piensa</span><span class="highlight">Latinoamérica.</span></h1>
    <p>Un espacio para encontrarnos alrededor de las ideas, la lectura y las preguntas que atraviesan nuestra región.</p>
    <Button href="#contact-tab-club">Unirme al club</Button>
  </div>
  <div class="section-wave" aria-hidden="true"><WaveDivider fillColor="#FFFFFF" variant="wave1" /></div>
</section>
<style>
  .hero { min-height: 100dvh; display: flex; align-items: center; background: var(--color-footer-bg); color: white; }
  .hero-background, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-shade { background: linear-gradient(90deg, rgb(0 0 0 / .8), rgb(0 0 0 / .4) 55%, rgb(0 0 0 / .15)); }
  .hero-content { padding-block: 145px 125px; }
  h1 { font-size: clamp(2rem, 4vw, 3.7rem); font-weight: 750; line-height: 1.08; text-transform: uppercase; letter-spacing: -.015em; }
  h1 span { display: block; }
  .highlight { color: #FBDB95; }
  p { max-width: 550px; font-size: 19px; line-height: 1.3; margin: 26px 0 46px; }
  @media (max-width: 639px) { .hero { min-height: 610px; } .hero-content { padding-block: 135px 100px; } h1 { font-size: clamp(1.7rem, 6.7vw, 2.7rem); } p { font-size: 16px; margin-block: 26px 34px; } }
</style>
