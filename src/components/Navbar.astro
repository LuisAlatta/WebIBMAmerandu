---
import { ArrowRight } from "lucide-react";
import MobileMenu from "./MobileMenu";
import ameranduLogo from "../assets/images/amerandu-logo-header.webp";
import { navigationLinks, participationLinks, navigationButtonClass, navigationButtonColors } from "../data/navigation";

interface Props { solid?: boolean; }
const { solid = false } = Astro.props;
---

<header
  id="navbar"
  data-solid={solid ? "true" : "false"}
  class={`fixed top-0 left-0 w-full z-50 transition-colors duration-200 ${solid ? "bg-verde-dark shadow-lg" : "bg-transparent"}`}
>
  <div class="header-inner">
    <a href="/#inicio" class="header-brand" aria-label="Amerandú — Inicio">
      <img src={ameranduLogo.src} width={ameranduLogo.width} height={ameranduLogo.height} alt="Amerandú" />
    </a>

    <nav class="desktop-navigation" aria-label="Navegación principal">
      <ul class="navigation-links">
        {navigationLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
      </ul>
      <div class="navigation-actions">
        {participationLinks.map(({ href, label, secondary }) => (
          <a href={href} class:list={[navigationButtonClass, secondary ? navigationButtonColors.secondary : navigationButtonColors.primary]}>
            {label}<ArrowRight size={16} aria-hidden="true" />
          </a>
        ))}
      </div>
    </nav>

    <MobileMenu client:load />
  </div>
</header>

<style>
  .header-inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; width: min(100% - 48px, 1440px); height: 80px; margin-inline: auto; }
  .header-brand { display: block; flex-shrink: 0; width: 145px; }
  .header-brand img { display: block; width: 100%; height: auto; }
  .header-brand:focus-visible { outline: 2px solid white; outline-offset: 5px; border-radius: 3px; }
  .desktop-navigation { display: none; align-items: center; gap: 26px; }
  .navigation-links { display: flex; align-items: center; gap: 15px; }
  .navigation-links a { display: block; padding-block: 12px; font-size: 13px; font-weight: 500; white-space: nowrap; color: rgb(255 255 255 / .95); transition: color .2s ease; }
  .navigation-links a:hover { color: var(--color-amarillo); }
  .navigation-links a:focus-visible { outline: 2px solid white; outline-offset: 4px; border-radius: 3px; }
  .navigation-actions { display: flex; gap: 10px; align-items: center; }
  @media (min-width: 1280px) {
    .desktop-navigation { display: flex; margin-left: auto; }
    .navigation-links { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  }
  @media (max-width: 639px) { .header-inner { height: 64px; width: calc(100% - 40px); } .header-brand { width: 130px; } }
  @media (prefers-reduced-motion: reduce) { .navigation-links a { transition: none; } }
</style>
