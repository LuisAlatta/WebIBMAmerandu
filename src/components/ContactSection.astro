---
import ContactForm from "./ContactForm";
import WaveDivider from "./WaveDivider.astro";
import "../styles/landing-sections.css";
---

<section id="contacto" class="landing-section contact-section" aria-labelledby="contact-title">
  <div class="contact-dots" aria-hidden="true"></div>
  <svg class="contact-shape" viewBox="0 0 560 220" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0C82 8 78 100 165 119S355 122 425 158S499 204 560 220H0Z" fill="#168568" />
  </svg>
  <div class="section-inner contact-layout">
    <div class="contact-heading">
      <p class="section-kicker">Encuentra tu lugar</p>
      <h2 id="contact-title" class="section-title">¡Forma parte<br />de Amerandú!</h2>
      <p class="contact-intro">Completa el formulario y nos pondremos en contacto contigo.</p>
    </div>
    <ContactForm client:visible />
  </div>
  <div class="section-wave" aria-hidden="true">
    <WaveDivider fillColor="var(--color-footer-bg)" variant="wave1" />
  </div>
</section>

<style>
  .contact-section { background: var(--color-verde-dark); padding-block: 100px 145px; }
  .contact-layout { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: 90px; align-items: start; max-width: 1100px; }
  .contact-heading { color: white; }
  .contact-heading .section-title { font-size: clamp(2rem, 3.4vw, 3rem); }
  .contact-heading .section-kicker { font-size: 14px; margin-bottom: 20px; }
  .contact-intro { font-size: 18px; line-height: 1.25; max-width: 410px; margin-top: 26px; }
  .contact-dots { position: absolute; top: 32%; left: 30%; width: 64%; height: 45%; opacity: .12; background-image: radial-gradient(#b8e5d2 1.7px, transparent 2px); background-size: 23px 23px; pointer-events: none; }
  .contact-shape { position: absolute; bottom: 0; left: 0; width: 42%; height: 220px; opacity: .5; pointer-events: none; }
  @media (max-width: 1050px) { .contact-layout { gap: 45px; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); } }
  @media (max-width: 850px) { .contact-layout { grid-template-columns: 1fr; max-width: 620px; gap: 45px; } .contact-heading { max-width: 470px; } }
  @media (max-width: 639px) { .contact-section { padding-block: 60px 90px; } .contact-intro { font-size: 16px; } .contact-dots { left: 0; width: 100%; } .contact-shape { width: 80%; height: 150px; } }
</style>
