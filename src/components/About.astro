---
import { UserRound, Eye } from "lucide-react";
import arrowIcon from "../assets/icons/arrow-icon.svg?url";
import WaveDivider from "./WaveDivider.astro";
import "../styles/landing-sections.css";
const principles = [
  { title: "Propósito", icon: UserRound, tone: "purpose", text: "Promover el encuentro y el diálogo en torno a la lectura y el pensamiento latinoamericano, generando un espacio colectivo de reflexión sobre la cultura y las ideas de la región." },
  { title: "Visión", icon: Eye, tone: "vision", text: "Ser un espacio de referencia para la lectura y el pensamiento latinoamericano, reuniendo una comunidad interesada en reflexionar sobre la identidad y la cultura de la región." },
  { title: "Misión", icon: arrowIcon, tone: "mission", text: "Crear un espacio de lectura y discusión que fomente el intercambio de ideas, la reflexión crítica y la construcción colectiva de conocimiento sobre América Latina." },
];
---
<section id="nosotros" class="landing-section about" aria-labelledby="about-title">
  <svg class="organic-decoration" viewBox="0 0 360 470" preserveAspectRatio="none" aria-hidden="true"><path fill="var(--color-verde-dark)" d="M0 0C70 15 30 135 55 165S95 222 76 285S77 347 112 381L0 470Z"/><path fill="var(--color-amarillo)" d="M0 285C72 260 35 347 81 362S198 363 232 397S267 408 301 426S342 455 360 470H0Z"/></svg>
  <div class="section-inner about-grid">
    <div class="about-copy">
      <p class="section-kicker">Nosotros</p>
      <h2 id="about-title" class="section-title">Sobre<br />Amerandú</h2>
      <p>Amerandú es una comunidad que encuentra en la lectura un punto de encuentro para conversar, cuestionar y pensar Latinoamérica.</p>
      <p>Más que leer libros, buscamos compartir ideas, perspectivas y preguntas que nos ayuden a comprender nuestra región.</p>
    </div>
    <div class="principles">
      {principles.map(({ title, icon: Icon, tone, text }) => (
        <article class="principle">
          <div class:list={["principle-icon", tone]}>
            {typeof Icon === "string"
              ? <img src={Icon} width={32} height={32} alt="" />
              : <Icon size={32} strokeWidth={2.4} aria-hidden="true" />}
          </div>
          <div><h3>{title}</h3><p>{text}</p></div>
        </article>
      ))}
    </div>
  </div>
  <div class="section-wave" aria-hidden="true"><WaveDivider fillColor="#fff5dd" variant="wave3" /></div>
</section>
<style>
  .about { background: white; padding-block: 110px 145px; }
  .about-grid { display: grid; grid-template-columns: .85fr 1.5fr; gap: clamp(50px, 7vw, 115px); align-items: start; }
  .about-copy { color: var(--color-verde-dark); }
  .about-copy .section-kicker { max-width: 310px; }
  .about-copy > p:not(.section-kicker) { font-size: 18px; line-height: 1.25; color: #505050; margin-top: 25px; }
  .principles { display: grid; gap: 45px; }
  .principle { display: grid; grid-template-columns: 64px 1fr; gap: 24px; align-items: start; }
  .principle-icon { height: 70px; display: grid; place-items: center; border-radius: 52% 48% 35% 65% / 45% 30% 70% 55%; }
  .purpose { background: #fbdb95; color: var(--section-mustard); }
  .vision { background: #43b28e; color: var(--color-verde-dark); border-radius: 36% 64% 53% 47% / 70% 65% 35% 30%; }
  .mission { background: #ff906e; color: var(--section-terracotta); }
  h3 { text-transform: uppercase; font-size: 20px; font-weight: 700; line-height: 1.2; margin-bottom: 8px; }
  .principle p { color: #505050; font-size: 15px; line-height: 1.2; letter-spacing: .035em; }
  .organic-decoration { position: absolute; bottom: 0; left: 0; width: min(25vw, 355px); height: 440px; pointer-events: none; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 45px; } .about-copy { max-width: 600px; } .organic-decoration { opacity: .12; } }
  @media (max-width: 639px) { .about { padding-block: 65px 90px; } .principle { grid-template-columns: 50px 1fr; gap: 18px; } .principle-icon { height: 58px; } .principles { gap: 32px; } }
</style>
